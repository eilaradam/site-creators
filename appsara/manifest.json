{
  "name": "Estúdio de Vídeos",
  "short_name": "Estúdio",
  "description": "Prompts de foto e vídeo com o produto travado para o TikTok Shop.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#5A1230",
  "theme_color": "#5A1230",
  "lang": "pt-BR",
  "icons": [
    {"src": "icon-192.png", "sizes": "192x192", "type": "image/png"},
    {"src": "icon-512.png", "sizes": "512x512", "type": "image/png"},
    {"src": "icon-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {"files": [{"name": "fotos", "accept": ["image/*"]}]}
  }
}
